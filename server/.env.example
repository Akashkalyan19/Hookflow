NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hookflow
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
WORKER_POLL_INTERVAL_MS=2000
